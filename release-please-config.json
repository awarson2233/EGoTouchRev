{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "EGoTouch",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": ["CMakeLists.txt"],
      "changelog-sections": [
        { "type": "feat", "section": "✨ 新功能" },
        { "type": "fix", "section": "🐛 修复" },
        { "type": "perf", "section": "⚡ 性能" },
        { "type": "refactor", "section": "♻️ 重构" },
        { "type": "docs", "section": "📝 文档" },
        { "type": "revert", "section": "⏪ 回退" },
        { "type": "build", "section": "🏗️ 构建", "hidden": true },
        { "type": "ci", "section": "👷 CI", "hidden": true },
        { "type": "chore", "section": "🧹 杂项", "hidden": true },
        { "type": "test", "section": "🧪 测试", "hidden": true },
        { "type": "style", "section": "🎨 风格", "hidden": true }
      ]
    }
  }
}
